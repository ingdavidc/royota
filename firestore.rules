rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Telemetría del MikroTik en tiempo real (Cloud Sync 24/7)
    match /telemetry/{doc} {
      allow read, write: if true;
    }

    // Ajustes del portal y Balneario: lectura pública, escritura admin o sync
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Planes y precios: lectura pública, escritura admin
    match /plans/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Fichas (vouchers):
    // - Prohibido el listado masivo anónimo para evitar robo de fichas (solo admin autenticado)
    // - Permitida la consulta individual (get: true) si se conoce el código (para portal)
    // - Creación, eliminación y listado: solo admin
    // - Activación: permitida al cliente si la ficha está disponible o vendida
    match /vouchers/{code} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.status in ['available', 'sold'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.plan_id == resource.data.plan_id
      );
    }

    // Kioskos y casetas (puntos de venta en efectivo): lectura pública, escritura admin o sync
    match /kiosks/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Lotes y ventas: solo admin
    match /voucher_batches/{doc} {
      allow read, write: if request.auth != null;
    }

    match /sales/{doc} {
      allow read, write: if request.auth != null;
    }

    // Todo lo demás requiere autenticación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
