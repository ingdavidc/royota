rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el administrador autenticado verificado (UID de Firebase Auth del sistema)
    // El backend Node.js en Render autentica mediante Service Account (Admin SDK / OAuth2),
    // el cual omite estas reglas de cliente de forma segura en el servidor.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '2yDqpc64kwQt92PqGOBefC38zA92'
        || request.auth.token.admin == true
      );
    }

    // Telemetría en tiempo real: solo lectura/escritura admin (el backend usa Service Account)
    match /telemetry/{doc} {
      allow read, write: if isAdmin();
    }

    // Ajustes del portal: lectura pública, escritura exclusivamente admin
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Planes y precios: lectura pública, escritura exclusivamente admin
    match /plans/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kioskos y casetas físicas: lectura pública, escritura exclusivamente admin
    match /kiosks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fichas (vouchers):
    // - Sin listado anónimo (`list` solo admin)
    // - Consulta individual `get` pública para activación en portal
    // - Creación y eliminación: solo admin
    // - Actualización anónima: únicamente transición única available|sold -> active sin alterar metadatos/precio/plan
    match /vouchers/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.status in ['available', 'sold']
        && request.resource.data.status == 'active'
        && request.resource.data.is_sold == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'is_sold', 'sold_at', 'activated_at', 'expires_at'])
      );
    }

    // Credenciales WhatsApp (Baileys): CERRADAS por completo a clientes (solo servidor vía Service Account)
    match /baileys_auth/{doc} {
      allow read, write: if false;
    }

    // Auditoría anti-fraude WhatsApp (pagos y strikes): solo lectura admin, escritura exclusiva servidor
    match /whatsapp_payments/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /whatsapp_strikes/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Quejas, reclamos y PQRS: solo admin en cliente (el bot escribe vía Service Account)
    match /complaints/{doc} {
      allow read, write: if isAdmin();
    }

    // Bandeja de salida WhatsApp (Outbox): solo admin en cliente (el bot lee/marca vía Service Account)
    match /whatsapp_outbox/{doc} {
      allow read, write: if isAdmin();
    }

    // Lotes de fichas: solo admin
    match /voucher_batches/{doc} {
      allow read, write: if isAdmin();
    }

    // Cortesía WhatsApp: solo MAC real, incremento estricto +1, prohibido auto-desbloquearse
    match /wa_trials/{mac} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() || (
        mac.matches('^([0-9A-F]{2}:){5}[0-9A-F]{2}$')
        && request.resource.data.unblocked == false
        && request.resource.data.attempts == 1
      );
      allow update: if isAdmin() || (
        mac.matches('^([0-9A-F]{2}:){5}[0-9A-F]{2}$')
        && request.resource.data.unblocked == false
        && (
          (resource.data.date != request.resource.data.date && request.resource.data.attempts == 1)
          || (resource.data.date == request.resource.data.date
              && resource.data.attempts < 2
              && request.resource.data.attempts == resource.data.attempts + 1)
        )
      );
    }

    // Ventas y facturación: lectura/edición/borrado solo admin;
    // creación desde portal ligada atómicamente a activación de ficha real con su precio exacto
    match /sales/{doc} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.payment_method == 'activacion_portal'
        && request.resource.data.keys().hasAll(['voucher_id', 'voucher_code', 'amount', 'created_at'])
        && exists(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher_id))
        && get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher_id)).data.status in ['available', 'sold']
        && getAfter(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher_id)).data.status == 'active'
        && request.resource.data.amount == get(/databases/$(database)/documents/vouchers/$(request.resource.data.voucher_id)).data.price
      );
    }

    // Dispositivos exentos por MAC (IP Binding): exclusivamente admin
    match /ip_bindings/{doc} {
      allow read, write: if isAdmin();
    }

    // Cualquier otra colección denegada salvo administrador
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
