rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Telemetría del MikroTik en tiempo real (Cloud Sync 24/7)
    match /telemetry/{doc} {
      allow read, write: if true;
    }

    // Ajustes del portal y Balneario: lectura pública, escritura admin o sync
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Planes y precios: lectura pública, escritura admin
    match /plans/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Fichas (vouchers):
    // - Prohibido el listado masivo anónimo para evitar robo de fichas (solo admin autenticado)
    // - Permitida la consulta individual (get: true) si se conoce el código (para portal)
    // - Creación, eliminación y listado: solo admin
    // - Activación: permitida al cliente si se cambia a 'active'
    match /vouchers/{code} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        request.resource.data.status in ['active', 'available']
      );
    }

    // Kioskos y casetas (puntos de venta en efectivo): lectura pública, escritura admin o sync
    match /kiosks/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Credenciales persistentes de WhatsApp (Baileys Cloud Session)
    match /baileys_auth/{doc} {
      allow read, write: if true;
    }

    // Quejas, reclamos y PQRS recibidas por WhatsApp o portal
    match /complaints/{doc} {
      allow read, write: if true;
    }

    // Mensajes pendientes de salida para el Bot de WhatsApp (Bandeja de Salida Outbox)
    match /whatsapp_outbox/{doc} {
      allow read, write: if true;
    }

    // Lotes de fichas (metadatos sin códigos): lectura y creación para impresión y panel
    match /voucher_batches/{doc} {
      allow read, write: if true;
    }

    // Control de intentos de navegación de cortesía para compras por WhatsApp (1 min x 2 intentos diarios)
    match /wa_trials/{doc} {
      allow read, write: if true;
    }

    // Registro de ventas y facturación (permite auto-facturación al activar en el portal)
    match /sales/{doc} {
      allow read, write: if true;
    }

    // Todo lo demás requiere autenticación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
