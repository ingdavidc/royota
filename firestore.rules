rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ajustes del portal y Balneario: lectura pública, escritura solo admin
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Planes y precios: lectura pública, escritura solo admin
    match /plans/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fichas (vouchers):
    // - Prohibido el listado masivo (list: false) para evitar robo de fichas
    // - Permitida la consulta individual (get: true) si se conoce el código
    // - Creación y eliminación: solo admin
    // - Activación: permitida al cliente si la ficha está disponible o vendida
    match /vouchers/{code} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.status in ['available', 'sold'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.plan_id == resource.data.plan_id
      );
    }

    // Lotes y ventas: solo admin
    match /voucher_batches/{doc} {
      allow read, write: if request.auth != null;
    }

    match /sales/{doc} {
      allow read, write: if request.auth != null;
    }

    // Todo lo demás requiere autenticación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
