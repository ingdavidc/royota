# ═══════════════════════════════════════════════════════════════
#  .env.example — Hotspot Fichas ROYOTA
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el .env real a Git.
# ═══════════════════════════════════════════════════════════════

# ── Servidor Web ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ=America/Bogota

# ── Ruta del volumen de datos (para docker-compose) ──────────
DATA_DIR=./data

# ── JWT — CAMBIA ESTE VALOR en producción ────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_48_CHARS
JWT_EXPIRES_IN=10h

# ── Negocio / Branding ───────────────────────────────────────
BUSINESS_NAME=WiFi ROYOTA
BUSINESS_CURRENCY=COP
BUSINESS_CURRENCY_SYMBOL=$

# ── MikroTik REST API ────────────────────────────────────────
# Si usas Tailscale:  100.x.y.z
# Si usas WireGuard: 10.10.10.1
# Si está en la misma LAN: 192.168.88.1
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=api-fichas
MIKROTIK_PASS=contraseña-segura-aqui

# Nombre del servidor Hotspot configurado en el MikroTik
MIKROTIK_HOTSPOT_SERVER=hotspot1

# Usar HTTPS para conectarse al router (recomendado: true)
MIKROTIK_USE_SSL=true

# Verificar certificado SSL del router
# false = aceptar self-signed (común en routers)
# true  = verificar CA (requiere certificado válido)
MIKROTIK_VERIFY_SSL=false

# Timeout de peticiones al router (ms)
MIKROTIK_TIMEOUT_MS=8000

# ── Scheduler de limpieza ─────────────────────────────────────
# Formato cron: minuto hora día-mes mes día-semana
# */15 * * * * = cada 15 minutos (recomendado)
CLEANUP_CRON=*/15 * * * *

# ── Admin por defecto (solo en el primer arranque) ────────────
# Después del primer login, cambia la contraseña desde el panel.
ADMIN_USER=admin
ADMIN_PASS=admin123

# ── Tailscale (solo si usas el sidecar) ──────────────────────
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxx
