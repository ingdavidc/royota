# ═══════════════════════════════════════════════════════════════
#  .env.example — Hotspot Fichas ROYOTA
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas el .env real ni llaves de servicio a Git.
# ═══════════════════════════════════════════════════════════════

# ── Servidor Web ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production
TZ=America/Bogota
DATA_DIR=./data

# ── JWT & Seguridad (OBLIGATORIO en producción) ──────────────
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_48_CHARS
JWT_EXPIRES_IN=10h
MIKROTIK_SYNC_TOKEN=CAMBIA_ESTO_POR_UN_TOKEN_SECRETO_DE_AL_MENOS_32_CHARS
CORS_ORIGINS=https://royota.dctelematica.com,http://localhost:3000,http://127.0.0.1:3000

# ── Firebase Admin / Service Account (OBLIGATORIO en Render) ─
FIREBASE_PROJECT_ID=fichas-royota
# Pega el JSON completo (o en Base64) de la Cuenta de Servicio de Firebase
FIREBASE_SERVICE_ACCOUNT=
ALLOWED_ADMIN_UIDS=2yDqpc64kwQt92PqGOBefC38zA92
ALLOWED_ADMIN_EMAILS=ing.david@dctelematica.com

# ── Negocio / Branding ───────────────────────────────────────
BUSINESS_NAME=WiFi ROYOTA
BUSINESS_CURRENCY=COP
BUSINESS_CURRENCY_SYMBOL=$

# ── MikroTik REST API & Cloud Sync ─────────────────────────
MIKROTIK_MOCK=false
MIKROTIK_CLOUD_SYNC_ONLY=true
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=api-fichas
MIKROTIK_PASS=contraseña-segura-aqui
MIKROTIK_HOTSPOT_SERVER=hotspot1
MIKROTIK_USE_SSL=true
MIKROTIK_VERIFY_SSL=true
MIKROTIK_TIMEOUT_MS=8000

# ── Scheduler de limpieza & Alertas de caída en sitio ───────
CLEANUP_CRON=*/5 * * * *
ALERT_ENABLED=true
ALERT_PHONE=3174251419
ALERT_OFFLINE_MINUTES=3

# ── Admin por defecto (solo en primer arranque local/SQLite) ─
ADMIN_USER=admin
ADMIN_PASS=CAMBIA_ESTA_CONTRASENA_FUERTE

# ── WhatsApp Bot con IA (Procesamiento Automático de Pagos) ───
WHATSAPP_ENABLED=true
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui
GEMINI_MODEL=gemini-2.5-flash
PAYMENT_PHONE=3174251419
DAVIPLATA_PHONE=3174251419
BREB_KEY=3174251419
